# docker compose only: copy to .env, then `docker compose up --build`.
# For `npm run dev`, each app reads its own .env.local (see frontend/ and backend/ .env.example).

POSTGRES_PASSWORD=vault_dev_password
# Host port for Postgres; change if 5432 is taken on your machine
POSTGRES_PORT=5432
# Random secrets: generate each with node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
INTERNAL_API_TOKEN=

# Admin account, created when the backend starts (admins cannot sign up in the app)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
