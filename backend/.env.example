# Copy to .env.local for `npm run dev`. On Railway, set these as service variables.

# Railway: ${{Postgres.DATABASE_URL}} (private network, no SSL needed)
DATABASE_URL=postgres://vault:vault_dev_password@localhost:5432/vault
# Set to "require" only when connecting over Railway's public proxy URL
DATABASE_SSL=

# Random secrets — generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# Must match the frontend's INTERNAL_API_TOKEN. Required in production.
INTERNAL_API_TOKEN=

# The frontend's public URL(s), comma-separated. Defaults to http://localhost:3000 in dev.
ALLOWED_ORIGINS=http://localhost:3000

# Admin account for `make db-seed-admin` / `npm run seed:admin` (also seeded on `npm start` when set).
# Admins cannot sign up in the app. Password: at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
