# Copy to .env.local for `npm run dev`. On Railway, set these as service variables.

# Where the API lives. Local dev: http://localhost:4000
# Railway: http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:${{backend.PORT}}
BACKEND_URL=http://localhost:4000
# Shared secret sent to the API on every request; must match the backend's value.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_TOKEN=
